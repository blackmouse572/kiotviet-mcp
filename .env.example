# ===========================================================================
# kiotviet-mcp — local Bun dev environment
# Copy to `.env` (Bun auto-loads it) and fill in real values.
# For Cloudflare Workers, set these as secrets via `wrangler secret put <NAME>`.
# ===========================================================================

# --- Required: bearer envelope keypair (32-byte hex each) -------------------
# Generate with:
#   bun -e 'import {generateKeyPairHex} from "./src/auth/envelope"; console.log(generateKeyPairHex())'
MCP_BEARER_PK=
MCP_BEARER_SK=

# --- Required: HMAC shared with your trusted backend for /internal/link + /tools
# >=16 chars. Same value must be configured on the calling backend.
LINK_HMAC_SECRET=

# --- Optional: default tool profile ------------------------------------------
# curated = smaller LLM-friendly catalog, full = all non-hidden tools.
DEFAULT_TOOL_PROFILE=curated

# --- Optional: AES-256-GCM wrap for KV-cached tokens (Workers only) --------
# 32-byte hex; generate with:
#   bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).reduce((s,b)=>s+b.toString(16).padStart(2,"0"),""))'
# TOKEN_CACHE_KEY=

# --- Bearer lifetime (seconds) ----------------------------------------------
# Default = 90 days. Managed-link callers re-link if expired; BYO clients re-run /authorize.
BEARER_TTL_SECONDS=7776000

# --- KiotViet IDP endpoint --------------------------------------------------
KIOTVIET_TOKEN_URL=https://id.kiotviet.vn/connect/token

# --- Bun dev server port ----------------------------------------------------
PORT=8787

# --- Public URL (used in BYO OAuth metadata) --------------------------------
# PUBLIC_BASE_URL=https://kiotviet-mcp.example.com
